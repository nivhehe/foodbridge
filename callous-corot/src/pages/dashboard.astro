---
import Layout from '../layouts/Layout.astro';
---

<Layout title="FoodBridge - Interactive Dashboard">
  <!-- Leaflet Interactive Map Assets -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <style is:global>
    @keyframes drift-1 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(60px, -40px) scale(1.05); }
    }
    @keyframes drift-2 {
      0%, 100% { transform: translate(0, 0) scale(1.03); }
      50% { transform: translate(-50px, 50px) scale(0.97); }
    }
    .animate-drift-1 {
      animation: drift-1 25s ease-in-out infinite;
    }
    .animate-drift-2 {
      animation: drift-2 30s ease-in-out infinite;
    }
    .map-grid {
      background-color: #f0f3eb;
      background-image: 
        radial-gradient(#d5d8cf 1.2px, transparent 1.2px),
        linear-gradient(to right, rgba(0,0,0,0.015) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0,0,0,0.015) 1px, transparent 1px);
      background-size: 24px 24px, 96px 96px, 96px 96px;
    }
    /* Smooth tab fade-in */
    .tab-content {
      animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>

  <!-- Interactive Mesh Background & Atmosphere -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute -right-32 -top-32 w-[600px] h-[600px] rounded-full bg-gradient-to-br from-primary/10 via-primary-pale/5 to-transparent blur-3xl opacity-50 animate-drift-1"></div>
    <div class="absolute -left-40 top-1/3 w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-accent-orange/5 via-accent-cyan/3 to-transparent blur-3xl opacity-40 animate-drift-2"></div>
    <div class="absolute right-1/4 bottom-10 w-[550px] h-[550px] rounded-full bg-gradient-to-br from-primary-pale/10 via-canvas-soft/5 to-transparent blur-3xl opacity-60"></div>
  </div>

  <div class="flex flex-col lg:flex-row min-h-screen bg-gradient-to-br from-canvas-soft via-canvas to-primary-pale/20 text-ink font-inter relative z-10">
    
    <!-- Premium Sidebar -->
    <aside class="w-full lg:w-[290px] bg-ink text-canvas-soft p-lg flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-ink/10 shadow-2xl lg:fixed lg:h-screen z-40 backdrop-blur-xl dark:bg-canvas dark:text-body">
      <div>
        <!-- Header with Hamburger on Mobile -->
        <div class="flex items-center justify-between mb-lg lg:mb-2xl">
          <!-- Logo Lockup -->
          <div class="flex items-center gap-md p-xs">
            <div class="w-11 h-11 rounded-xl flex items-center justify-center text-2xl bg-gradient-to-br from-primary via-primary-neutral to-primary-active shadow-lg shadow-primary/20 transform hover:scale-105 transition-transform duration-200 select-none">
              🍽️
            </div>
            <div>
              <div class="font-wise-sans font-black text-xl tracking-tight leading-none text-primary select-none">FoodBridge</div>
              <div class="text-[9px] text-canvas-soft/60 font-bold uppercase tracking-wider mt-[4px] block select-none dark:text-body/60">Smart Redistribution</div>
            </div>
          </div>

          <!-- Hamburger Button (mobile only) -->
          <button onclick="toggleMobileMenu()" class="lg:hidden p-sm text-canvas-soft hover:text-white hover:bg-canvas-soft/10 rounded-xl cursor-pointer transition-colors focus:outline-none focus:ring-2 focus:ring-primary dark:text-body dark:hover:text-ink dark:hover:bg-body/10" aria-label="Toggle Navigation Menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          </button>
        </div>

        <!-- Nav container that collapses on mobile -->
        <div id="mobileNavWrapper" class="hidden lg:flex flex-col flex-1 justify-between gap-xl">
          <!-- Navigation Links with Custom Active Glow -->
          <nav class="flex flex-col gap-sm" id="sidebarNav">
            <button id="nav-overview" class="w-full text-left py-md px-lg rounded-xl font-bold text-sm transition-all duration-200 cursor-pointer text-on-primary bg-primary flex items-center gap-sm shadow-lg shadow-primary/10 group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" onclick="switchTab('overview')">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 transition-transform duration-200 group-hover:scale-110 shrink-0"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
              Dashboard
            </button>
            <button id="nav-post" class="w-full text-left py-md px-lg rounded-xl font-semibold text-sm transition-all duration-200 cursor-pointer text-canvas-soft/60 hover:text-white hover:bg-canvas-soft/5 dark:text-body/60 dark:hover:text-ink dark:hover:bg-body/5 flex items-center gap-sm group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" onclick="switchTab('post')">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 transition-transform duration-200 group-hover:scale-110 shrink-0"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Post Food
            </button>
            <button id="nav-browse" class="w-full text-left py-md px-lg rounded-xl font-semibold text-sm transition-all duration-200 cursor-pointer text-canvas-soft/60 hover:text-white hover:bg-canvas-soft/5 dark:text-body/60 dark:hover:text-ink dark:hover:bg-body/5 flex items-center gap-sm group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" onclick="switchTab('browse')">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 transition-transform duration-200 group-hover:scale-110 shrink-0"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              Browse Food
            </button>
            <button id="nav-myposts" class="w-full text-left py-md px-lg rounded-xl font-semibold text-sm transition-all duration-200 cursor-pointer text-canvas-soft/60 hover:text-white hover:bg-canvas-soft/5 dark:text-body/60 dark:hover:text-ink dark:hover:bg-body/5 flex items-center gap-sm group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" onclick="switchTab('myposts')">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 transition-transform duration-200 group-hover:scale-110 shrink-0"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="15" y2="16"/></svg>
              My Posts
            </button>
            <button id="nav-history" class="w-full text-left py-md px-lg rounded-xl font-semibold text-sm transition-all duration-200 cursor-pointer text-canvas-soft/60 hover:text-white hover:bg-canvas-soft/5 dark:text-body/60 dark:hover:text-ink dark:hover:bg-body/5 flex items-center gap-sm group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" onclick="switchTab('history')">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 transition-transform duration-200 group-hover:scale-110 shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              History
            </button>
            <button id="nav-chats" class="w-full text-left py-md px-lg rounded-xl font-semibold text-sm transition-all duration-200 cursor-pointer text-canvas-soft/60 hover:text-white hover:bg-canvas-soft/5 dark:text-body/60 dark:hover:text-ink dark:hover:bg-body/5 flex items-center gap-sm group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" onclick="switchTab('chats')">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 transition-transform duration-200 group-hover:scale-110 shrink-0"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Chats
            </button>
            <button id="nav-profile" class="w-full text-left py-md px-lg rounded-xl font-semibold text-sm transition-all duration-200 cursor-pointer text-canvas-soft/60 hover:text-white hover:bg-canvas-soft/5 dark:text-body/60 dark:hover:text-ink dark:hover:bg-body/5 flex items-center gap-sm group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" onclick="switchTab('profile')">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 transition-transform duration-200 group-hover:scale-110 shrink-0"><path d="M20 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Profile
            </button>
          </nav>

          <!-- Logout Component with Red Hue -->
          <button class="w-full py-md px-lg bg-transparent border border-negative/30 hover:bg-negative hover:text-canvas-soft dark:hover:text-body text-negative rounded-xl font-bold text-sm transition-all duration-200 cursor-pointer mt-2xl flex items-center justify-center gap-sm shadow-sm hover:shadow-negative/15 focus-visible:ring-2 focus-visible:ring-negative focus-visible:outline-none group" onclick="logout()">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px] transition-transform duration-200 group-hover:translate-x-1"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Logout
          </button>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 lg:ml-[290px] p-lg md:p-2xl flex flex-col gap-xl">
      
      <!-- Top Premium Header Bar -->
      <header class="bg-canvas/80 backdrop-blur-md border border-ink/5 rounded-xl p-lg shadow-sm flex flex-col md:flex-row justify-between items-center gap-md">
        <div>
          <h1 id="pageTitle" class="display-sm text-ink mb-[2px] font-black text-wrap-balance">Dashboard Overview</h1>
          <p class="body-sm text-mute">Track donations, coordinate pickups, and reduce food waste in real time.</p>
        </div>
        
        <!-- Theme Toggle & User Block -->
        <div class="flex items-center gap-md">
          <button id="themeToggleBtn" onclick="toggleTheme()" class="w-10 h-10 rounded-full bg-canvas border border-ink/10 flex items-center justify-center text-ink hover:bg-canvas-soft cursor-pointer transition-colors focus:outline-none focus:ring-2 focus:ring-primary shrink-0" aria-label="Toggle Dark Mode">
            <!-- Sun Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 block dark:hidden"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            <!-- Moon Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 hidden dark:block"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>
          
          <div class="flex items-center gap-md p-[2px] bg-canvas-soft/50 rounded-full pr-lg border border-canvas-soft">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary via-primary-neutral to-primary-active text-on-primary flex items-center justify-center font-black text-xl shadow-md border border-canvas" id="userAvatar">
              U
            </div>
            <div>
              <div class="body-md-strong text-ink leading-tight" id="userName">User Name</div>
              <div class="text-[10px] text-mute font-bold uppercase tracking-wider mt-[2px]" id="userType">Restaurant / Donor</div>
            </div>
          </div>
        </div>
      </header>

      <!-- SECTIONS -->

      <!-- 1. Overview Section -->
      <section id="overview" class="tab-content flex flex-col gap-xl">
        <!-- Highlights Cards with Glassmorphism -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-md">
          
          <!-- Card 1: Reduce Waste -->
          <div class="bg-canvas/90 backdrop-blur-md p-xl rounded-xl border border-ink/5 flex flex-col gap-md transition-[box-shadow,border-color,transform] duration-300 hover:border-primary/40 hover:shadow-md motion-safe:hover:-translate-y-[4px] relative overflow-hidden group">
            <div class="absolute -right-10 -bottom-10 w-28 h-28 rounded-full bg-primary/10 blur-xl opacity-80 transition-[transform,opacity] duration-500 group-hover:scale-125 group-hover:opacity-100 pointer-events-none" aria-hidden="true"></div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-gradient-to-br from-primary/10 to-primary/25 text-ink-deep border border-primary/20 shadow-xs transition-transform duration-300 group-hover:scale-110">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 12a9 9 0 0 1 15-6.7L21 8" />
                <path d="M21 3v5h-5" />
                <path d="M21 12a9 9 0 0 1-15 6.7L3 16" />
                <path d="M3 21v-5h5" />
              </svg>
            </div>
            <div class="flex flex-col gap-xxs z-10">
              <h3 class="body-md-strong text-ink font-bold tracking-tight text-[17px] text-wrap-balance group-hover:text-ink-deep transition-colors duration-200">Reduce Waste</h3>
              <p class="caption text-mute leading-relaxed mt-xxs">Divert surplus meals from landfills and promote environmental health.</p>
            </div>
          </div>

          <!-- Card 2: Feed Hope -->
          <div class="bg-canvas/90 backdrop-blur-md p-xl rounded-xl border border-ink/5 flex flex-col gap-md transition-[box-shadow,border-color,transform] duration-300 hover:border-accent-orange/40 hover:shadow-md motion-safe:hover:-translate-y-[4px] relative overflow-hidden group">
            <div class="absolute -right-10 -bottom-10 w-28 h-28 rounded-full bg-accent-orange/10 blur-xl opacity-80 transition-[transform,opacity] duration-500 group-hover:scale-125 group-hover:opacity-100 pointer-events-none" aria-hidden="true"></div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-gradient-to-br from-accent-orange/10 to-accent-orange/25 text-negative-deep border border-accent-orange/20 shadow-xs transition-transform duration-300 group-hover:scale-110">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
              </svg>
            </div>
            <div class="flex flex-col gap-xxs z-10">
              <h3 class="body-md-strong text-ink font-bold tracking-tight text-[17px] text-wrap-balance group-hover:text-ink-deep transition-colors duration-200">Feed Hope</h3>
              <p class="caption text-mute leading-relaxed mt-xxs">Enable local charities to recover food and feed families in need.</p>
            </div>
          </div>

          <!-- Card 3: Carbon Offset -->
          <div class="bg-canvas/90 backdrop-blur-md p-xl rounded-xl border border-ink/5 flex flex-col gap-md transition-[box-shadow,border-color,transform] duration-300 hover:border-accent-cyan/40 hover:shadow-md motion-safe:hover:-translate-y-[4px] relative overflow-hidden group">
            <div class="absolute -right-10 -bottom-10 w-28 h-28 rounded-full bg-accent-cyan/10 blur-xl opacity-80 transition-[transform,opacity] duration-500 group-hover:scale-125 group-hover:opacity-100 pointer-events-none" aria-hidden="true"></div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-gradient-to-br from-accent-cyan/10 to-accent-cyan/25 text-[#0891b2] border border-accent-cyan/20 shadow-xs transition-transform duration-300 group-hover:scale-110">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 3.5 1 8a7 7 0 0 1-9 10Z" />
                <path d="M19 2c-2.26 4.33-5.27 7.14-8 10" />
              </svg>
            </div>
            <div class="flex flex-col gap-xxs z-10">
              <h3 class="body-md-strong text-ink font-bold tracking-tight text-[17px] text-wrap-balance group-hover:text-ink-deep transition-colors duration-200">Carbon Offset</h3>
              <p class="caption text-mute leading-relaxed mt-xxs">Track carbon footprint reduction dynamically based on surplus shared.</p>
            </div>
          </div>

          <!-- Card 4: Community -->
          <div class="bg-canvas/90 backdrop-blur-md p-xl rounded-xl border border-ink/5 flex flex-col gap-md transition-[box-shadow,border-color,transform] duration-300 hover:border-primary-neutral/40 hover:shadow-md motion-safe:hover:-translate-y-[4px] relative overflow-hidden group">
            <div class="absolute -right-10 -bottom-10 w-28 h-28 rounded-full bg-primary-pale/15 blur-xl opacity-80 transition-[transform,opacity] duration-500 group-hover:scale-125 group-hover:opacity-100 pointer-events-none" aria-hidden="true"></div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-gradient-to-br from-primary-neutral/20 to-primary-neutral/45 text-[#c2410c] border border-primary-neutral/30 shadow-xs transition-transform duration-300 group-hover:scale-110">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            </div>
            <div class="flex flex-col gap-xxs z-10">
              <h3 class="body-md-strong text-ink font-bold tracking-tight text-[17px] text-wrap-balance group-hover:text-ink-deep transition-colors duration-200">Community</h3>
              <p class="caption text-mute leading-relaxed mt-xxs">Build trusted linkages between local businesses and food banks.</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-xl">
          <!-- Metrics Visual Section -->
          <div class="bg-canvas border border-ink/5 rounded-xl p-xl shadow-sm flex flex-col gap-lg relative overflow-hidden">
            <h3 class="display-xs text-ink font-black border-b border-canvas-soft pb-sm select-none text-wrap-balance">Live Platform Snapshot</h3>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-md font-inter">
              <!-- Metric 1: Active Listings -->
              <div class="bg-canvas p-lg rounded-xl text-center border border-canvas-soft border-t-4 border-t-primary/70 shadow-sm relative overflow-hidden transition-all duration-300 hover:shadow-md hover:-translate-y-[2px]">
                <div class="display-sm text-ink font-black mb-[2px] tracking-tight tabular-nums" id="metricActivePosts">0</div>
                <div class="caption text-mute font-bold uppercase tracking-wider text-[10px] select-none">Active Listings</div>
              </div>
              <!-- Metric 2: Live Claims -->
              <div class="bg-canvas p-lg rounded-xl text-center border border-canvas-soft border-t-4 border-t-accent-orange/70 shadow-sm relative overflow-hidden transition-all duration-300 hover:shadow-md hover:-translate-y-[2px]">
                <div class="display-sm text-ink font-black mb-[2px] tracking-tight tabular-nums" id="metricMyPosts">0</div>
                <div class="caption text-mute font-bold uppercase tracking-wider text-[10px] select-none" id="metricMyPostsLabel">My Active Posts</div>
              </div>
              <!-- Metric 3: Pickup Ready -->
              <div class="bg-canvas p-lg rounded-xl text-center border border-canvas-soft border-t-4 border-t-accent-cyan/70 shadow-sm relative overflow-hidden transition-all duration-300 hover:shadow-md hover:-translate-y-[2px]">
                <div class="display-sm text-ink font-black mb-[2px] tracking-tight tabular-nums" id="metricPickupReady">0</div>
                <div class="caption text-mute font-bold uppercase tracking-wider text-[10px] select-none">Pickup Ready</div>
              </div>
            </div>

            <!-- Weekly Performance Mini-Chart -->
            <div class="flex flex-col gap-sm mt-sm border-t border-canvas-soft pt-lg">
              <h4 class="body-sm-strong text-ink font-bold uppercase tracking-wider text-[11px] mb-xs">Daily Rescued Meals (Past 5 Days)</h4>
              <div class="flex items-end justify-between gap-sm h-32 px-md pt-md pb-xs bg-canvas-soft/10 rounded-xl border border-canvas-soft/30">
                <div class="flex flex-col items-center justify-end h-full flex-1 group gap-xxs">
                  <span class="caption text-[10px] text-mute font-bold opacity-0 group-hover:opacity-100 transition-opacity tabular-nums">42 meals</span>
                  <div class="w-8 md:w-12 bg-primary-neutral hover:bg-primary rounded-t-md transition-all duration-300 h-[60%] group-hover:scale-y-105 origin-bottom relative shadow-xs"></div>
                  <span class="caption text-[10px] text-mute font-bold select-none">Mon</span>
                </div>
                <div class="flex flex-col items-center justify-end h-full flex-1 group gap-xxs">
                  <span class="caption text-[10px] text-mute font-bold opacity-0 group-hover:opacity-100 transition-opacity tabular-nums">28 meals</span>
                  <div class="w-8 md:w-12 bg-primary-neutral hover:bg-primary rounded-t-md transition-all duration-300 h-[40%] group-hover:scale-y-105 origin-bottom relative shadow-xs"></div>
                  <span class="caption text-[10px] text-mute font-bold select-none">Tue</span>
                </div>

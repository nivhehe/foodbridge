                <input type="text" id="chatMessageInput" class="bg-canvas text-ink border border-ink/20 rounded-xl px-md py-md body-sm focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/15 transition-all w-full pr-[60px]" placeholder="Type your coordinate instructions, pickup ETA, or question..." required>
                <button type="submit" class="absolute right-[6px] w-10 h-10 rounded-lg bg-primary text-on-primary hover:bg-primary-active flex items-center justify-center transition-colors shadow-sm focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none shrink-0" aria-label="Send Message">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>

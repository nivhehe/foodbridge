    </main>
  </div>

  <!-- Client-Side Dashboard Scripting -->
  <script is:inline>
    const API_STORAGE_KEY = 'foodbridge_api_url';
    const DEFAULT_REMOTE_API_URL = 'https://foodbridge.online/api';

    let leafletMap = null;
    let mapMarkersGroup = null;
    let activeOrderId = null;
    let activeChatPollInterval = null;

    function normalizeApiUrl(url) {
      return String(url || '').trim().replace(/\/+$/, '');
    }

    function isLocalHost(host) {
      return /^(127\.0\.0\.1|localhost|0\.0\.0\.0|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3})$/.test(host);
    }

    function getStoredApiUrl() {
      return normalizeApiUrl(sessionStorage.getItem(API_STORAGE_KEY));
    }

    function rememberApiUrl(url) {
      const normalized = normalizeApiUrl(url);
      if (!normalized) return;
      sessionStorage.setItem(API_STORAGE_KEY, normalized);
    }

    function resolveApiBaseUrl() {
      const fromQuery = new URLSearchParams(window.location.search).get('api');
      const fromGlobal = window.FOODBRIDGE_API_URL;
      const host = window.location.hostname || 'localhost';
      const isLocal = isLocalHost(host) || window.location.protocol === 'file:';
      const fallback = isLocal ? `http://${host}:5001/api` : '/api';
      return normalizeApiUrl(fromQuery || fromGlobal || getStoredApiUrl() || fallback);
    }

    let API_URL = resolveApiBaseUrl();
    const API_DEBUG_BADGE_ID = 'apiDebugBadge';

    function getApiCandidates() {
      const host = window.location.hostname || 'localhost';
      const isLocal = isLocalHost(host) || window.location.protocol === 'file:';
      const candidates = [
        !isLocal ? '/api' : '',
        normalizeApiUrl(new URLSearchParams(window.location.search).get('api')),
        normalizeApiUrl(window.FOODBRIDGE_API_URL),
        getStoredApiUrl(),
        isLocal ? `http://${host}:5001/api` : '',
        isLocal ? 'http://localhost:5001/api' : '',
        isLocal ? 'http://127.0.0.1:5001/api' : '',
        API_URL,
        !isLocal ? DEFAULT_REMOTE_API_URL : ''
      ].filter(Boolean);
      return [...new Set(candidates)];
    }

    function buildApiUrl(base, path) {
      const normalizedBase = normalizeApiUrl(base);
      const normalizedPath = path.startsWith('/') ? path : `/${path}`;
      return `${normalizedBase}${normalizedPath}`;
    }

    async function fetchWithTimeout(url, options = {}, timeoutMs = 45000) {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), timeoutMs);
      try {
        return await fetch(url, { ...options, signal: controller.signal });
      } finally {
        clearTimeout(timeout);
      }
    }

    async function apiFetch(path, options = {}, timeoutMs = 45000) {
      const candidates = getApiCandidates();
      let lastError = null;

      for (const base of candidates) {
        try {
          const response = await fetchWithTimeout(buildApiUrl(base, path), options, timeoutMs);
          const contentType = response.headers.get('content-type') || '';
          const looksLikeHtml = contentType.includes('text/html');

          if (response.status === 404 && looksLikeHtml) continue;
          if (looksLikeHtml) continue;

          API_URL = normalizeApiUrl(base);
          rememberApiUrl(API_URL);
          renderApiBadge();
          return response;
        } catch (error) {
          lastError = error;
        }
      }

      console.error('API candidates tried:', candidates, 'lastError:', lastError);
      if (lastError) throw lastError;
      throw new Error('No reachable API endpoint');
    }

    async function parseJsonResponse(response) {
      try {
        return await response.json();
      } catch (error) {
        return null;
      }
    }

    function renderApiBadge() {
      let badge = document.getElementById(API_DEBUG_BADGE_ID);
      if (!badge) {
        badge = document.createElement('div');
        badge.id = API_DEBUG_BADGE_ID;
        badge.style.cssText = 'position:fixed;right:14px;bottom:14px;background:#ffffff;border:1px solid #0e0f0c;color:#0e0f0c;padding:8px 12px;border-radius:12px;font-size:11px;z-index:3000;font-weight:700;box-shadow:0 8px 20px rgba(0,0,0,0.06);';
        document.body.appendChild(badge);
      }
      badge.textContent = `API: ${API_URL}`;
    }

    // Toggle Map/List View
    window.toggleBrowseView = function(viewType) {
      const listEl = document.getElementById('browseListView');
      const mapEl = document.getElementById('browseMapView');
      const listBtn = document.getElementById('viewListBtn');
      const mapBtn = document.getElementById('viewMapBtn');

      if (viewType === 'list') {
        listEl.classList.remove('hidden');
        mapEl.classList.add('hidden');
        listBtn.className = "py-[6px] px-lg rounded-lg text-xs font-bold bg-canvas text-ink shadow-sm border border-ink/5 cursor-pointer transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none";
        mapBtn.className = "py-[6px] px-lg rounded-lg text-xs font-bold text-mute hover:text-ink hover:bg-canvas/40 cursor-pointer transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none";
      } else {
        listEl.classList.add('hidden');
        mapEl.classList.remove('hidden');
        mapEl.className = "flex flex-col gap-md animate-fadeIn";
        listBtn.className = "py-[6px] px-lg rounded-lg text-xs font-bold text-mute hover:text-ink hover:bg-canvas/40 cursor-pointer transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none";
        mapBtn.className = "py-[6px] px-lg rounded-lg text-xs font-bold bg-canvas text-ink shadow-sm border border-ink/5 cursor-pointer transition-all focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none";
        
        // Render Leaflet map
        if (window.currentFoodListings) {
          generateMapPins(window.currentFoodListings);
        }
        if (leafletMap) {
          setTimeout(() => {
            leafletMap.invalidateSize();
          }, 100);
        }
      }
    };

    // Tab switcher
    window.switchTab = function(tab) {
      // Clear any active message polling interval
      if (activeChatPollInterval) {
        clearInterval(activeChatPollInterval);
        activeChatPollInterval = null;
      }

      document.querySelectorAll('.tab-content').forEach(s => s.classList.add('hidden'));
      document.getElementById(tab).classList.remove('hidden');
      
      document.querySelectorAll('#sidebarNav button').forEach(btn => {
        btn.className = "w-full text-left py-md px-lg rounded-xl font-semibold text-sm transition-all duration-200 cursor-pointer text-canvas-soft/60 hover:text-white hover:bg-canvas-soft/5 dark:text-body/60 dark:hover:text-ink dark:hover:bg-body/5 flex items-center gap-sm group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none";
      });

      const activeBtn = document.getElementById(`nav-${tab}`);
      if (activeBtn) {
        activeBtn.className = "w-full text-left py-md px-lg rounded-xl font-bold text-sm transition-all duration-200 cursor-pointer text-on-primary bg-primary flex items-center gap-sm shadow-lg shadow-primary/10 group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none";
      }

      if (tab === 'chats') {
        loadChatsList();
        // Reset state
        activeOrderId = null;
        lastFetchedMessageCount = 0;
        document.getElementById('chatRoomEmptyState').style.display = 'flex';
        document.getElementById('chatRoomActiveState').classList.add('hidden');
        document.getElementById('chatRoomActiveState').style.display = 'none';
      }

      // Set Page Title
      const titleMap = {
        overview: 'Dashboard Overview',
        post: 'Post Surplus Food',
        browse: 'Browse Surplus Food',
        myposts: 'My Listings',
        history: 'Donation History',
        chats: 'Pickup Coordination Chat',
        profile: 'Organization Profile'
      };
      document.getElementById('pageTitle').textContent = titleMap[tab] || 'Dashboard';

      // Collapse mobile menu if open
      const wrapper = document.getElementById('mobileNavWrapper');
      if (wrapper && !wrapper.classList.contains('hidden') && window.innerWidth < 1024) {
        wrapper.classList.add('hidden');
      }
    };

    window.toggleMobileMenu = function() {
      const wrapper = document.getElementById('mobileNavWrapper');
      if (wrapper) {
        wrapper.classList.toggle('hidden');
      }
    };

    window.toggleProfileEdit = function() {
      const viewProfile = document.getElementById('viewProfile');
      const editProfile = document.getElementById('editProfile');
      const btn = document.getElementById('editProfileBtn');

      if (editProfile.classList.contains('hidden')) {
        viewProfile.classList.add('hidden');
        editProfile.classList.remove('hidden');
        btn.textContent = 'Cancel';
        btn.className = "bg-negative/10 hover:bg-negative-deep text-negative border border-negative/20 transition-all duration-200 rounded-xl px-xl py-sm text-sm font-bold cursor-pointer focus-visible:ring-2 focus-visible:ring-negative focus-visible:outline-none";
      } else {
        viewProfile.classList.remove('hidden');
        editProfile.classList.add('hidden');
        btn.textContent = 'Edit Profile';
        btn.className = "bg-canvas-soft border border-ink/15 text-ink hover:bg-primary-pale border border-transparent transition-all duration-200 rounded-xl px-xl py-sm text-sm font-bold cursor-pointer focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none";
      }
    };

    function showMsg(text, type, elemId) {
      const msg = document.getElementById(elemId);
      msg.textContent = text;
      msg.className = `p-md rounded-xl text-sm font-bold leading-relaxed mb-md ${
        type === 'success' ? 'bg-primary-pale text-positive-deep border border-positive/20' : 'bg-negative-bg text-negative border border-negative/20'
      }`;
      msg.classList.remove('hidden');
      setTimeout(() => msg.classList.add('hidden'), 5000);
    }

    let localClaims = {};

    async function syncClaimsFromDB() {
      const token = localStorage.getItem('token');
      const userId = localStorage.getItem('userId');
      const userType = localStorage.getItem('userType') || '';
      const isNGO = userType.toLowerCase().includes('ngo');

      if (!token || !userId) return;

      try {
        let res;
        if (isNGO) {
          res = await apiFetch(`/orders/ngo/${userId}`);
        } else {
          res = await apiFetch(`/orders/restaurant/${userId}`);
        }
        
        const orders = await parseJsonResponse(res);
        if (res.ok && Array.isArray(orders)) {
          localClaims = {};
          orders.forEach(order => {
            if (order.status === 'pending' && order.food) {
              localClaims[order.food._id] = {
                orderId: order._id,
                handshakeCode: order.handshakeCode,
                claimedAt: order.createdAt,
                partner: isNGO 
                  ? (order.food.postedBy || {})
                  : (order.ngo || {})
              };
            }
          });
          
          if (isNGO) {
            document.getElementById('metricMyPosts').textContent = Object.keys(localClaims).length;
          }
        }
      } catch (err) {
        console.log('Error syncing claims from DB:', err);
      }
    }

    window.claimFoodItem = async function(foodId) {
      const confirmed = window.confirm('Are you sure you want to claim this surplus food item for pickup?');
      if (!confirmed) return;

      const token = localStorage.getItem('token');
      const userId = localStorage.getItem('userId');

      try {
        const res = await apiFetch('/orders', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}` 
          },
          body: JSON.stringify({ food: foodId, ngo: userId })
        });

        const order = await parseJsonResponse(res);
        if (res.ok && order) {
          showMsg('✓ Food item claimed successfully! Coordination details unlocked.', 'success', 'browseMsg');
          await syncClaimsFromDB();
          await loadBrowseFood();
        } else {
          showMsg(`✗ ${order?.message || 'Failed to claim food item'}`, 'error', 'browseMsg');
        }
      } catch (err) {
        showMsg('✗ Unable to reach the server for claiming.', 'error', 'browseMsg');
      }
    };

    window.releaseFoodItem = async function(foodId) {
      const confirmed = window.confirm('Are you sure you want to release this claimed food item back to active browse?');
      if (!confirmed) return;

      const token = localStorage.getItem('token');

      try {
        const res = await apiFetch(`/orders/food/${foodId}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });

        const result = await parseJsonResponse(res);
        if (res.ok) {
          showMsg('✓ Claim released successfully.', 'success', 'browseMsg');
          await syncClaimsFromDB();
          await loadBrowseFood();
        } else {
          showMsg(`✗ ${result?.message || 'Failed to release claim'}`, 'error', 'browseMsg');
        }
      } catch (err) {
        showMsg('✗ Unable to reach the server for releasing claim.', 'error', 'browseMsg');
      }
    };

    window.completeVerification = async function(foodId, enteredCode) {
      const token = localStorage.getItem('token');

      try {
        const res = await apiFetch('/orders/verify', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}` 
          },
          body: JSON.stringify({ foodId, handshakeCode: enteredCode })
        });

        const result = await parseJsonResponse(res);
        if (res.ok) {
          alert('✓ Verification Success! Donation status marked as Completed.');
          closeFoodModal();
          await syncClaimsFromDB();
          await loadBrowseFood();
          await loadHistory();
        } else {
          alert(`✗ Verification failed: ${result?.message || 'Invalid code'}`);
        }
      } catch (err) {
        alert('✗ Error confirming handshake with server.');
      }
    };

    async function loadHistory() {
      const token = localStorage.getItem('token');
      const userId = localStorage.getItem('userId');
      const userType = localStorage.getItem('userType') || '';
      const isNGO = userType.toLowerCase().includes('ngo');

      if (!token || !userId) return;

      const tbody = document.querySelector('#historyTable tbody');
      if (!tbody) return;

      try {
        let res;
        if (isNGO) {
          res = await apiFetch(`/orders/ngo/${userId}`);
        } else {
          res = await apiFetch(`/orders/restaurant/${userId}`);
        }

        const orders = await parseJsonResponse(res);
        if (!res.ok || !Array.isArray(orders)) {
          throw new Error('History request failed');
        }

        if (orders.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="p-xl text-center text-mute font-semibold">No donation history found.</td></tr>';
          return;
        }

        tbody.innerHTML = orders.map(order => {
          if (!order.food) return '';
          
          const dateStr = new Date(order.createdAt).toLocaleDateString();
          const foodDetails = order.food.name;
          const counterpart = isNGO 
            ? (order.food.postedBy?.orgName || 'Unknown Restaurant')
            : (order.ngo?.orgName || 'Unknown NGO');
          
          const qtyStr = `${order.quantity} ${order.food.unit || 'units'}`;
          const handshake = `<span class="bg-primary-pale text-positive-deep px-sm py-[2px] rounded-md font-bold text-xs border border-primary/20 tabular-nums">${order.handshakeCode}</span>`;
          
          const statusBadge = order.status === 'completed'
            ? `<span class="bg-primary-pale text-positive-deep px-md py-xs rounded-full font-bold text-xs select-none">Completed</span>`
            : `<span class="bg-warning-deep/15 text-warning-deep border border-warning/20 px-md py-xs rounded-full font-bold text-xs select-none">Pending Pickup</span>`;

          return `
            <tr class="hover:bg-canvas-soft/20 border-b border-canvas-soft">
              <td class="p-md font-semibold text-mute tabular-nums">${dateStr}</td>
              <td class="p-md font-bold text-ink">${foodDetails}</td>
              <td class="p-md">${counterpart}</td>
              <td class="p-md tabular-nums">${qtyStr}</td>
              <td class="p-md">${handshake}</td>
              <td class="p-md">${statusBadge}</td>
            </tr>
          `;
        }).join('');
      } catch (err) {
        console.log('Error loading history:', err);
        tbody.innerHTML = '<tr><td colspan="6" class="p-xl text-center text-mute font-semibold text-negative">Failed to load donation history.</td></tr>';
      }
    }

    async function loadProfileData() {
      const token = localStorage.getItem('token');
      const userId = localStorage.getItem('userId');

      try {
        const res = await apiFetch(`/users/${userId}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const data = await parseJsonResponse(res);

        if (!res.ok || !data) {
          throw new Error('Profile request failed');
        }

        document.getElementById('viewUserId').textContent = userId;
        document.getElementById('viewOrgName').textContent = data.orgName || 'Not Set';
        document.getElementById('viewEmail').textContent = data.email || 'Not Set';
        document.getElementById('viewPhone').textContent = data.phone || 'Not Set';
        document.getElementById('viewAddress').textContent = data.address || 'Not Set';
        document.getElementById('viewDescription').textContent = data.description || 'Not Set';

        document.getElementById('editOrgName').value = data.orgName || '';
        document.getElementById('editEmail').value = data.email || '';
        document.getElementById('editPhone').value = data.phone || '';
        document.getElementById('editAddress').value = data.address || '';
        document.getElementById('editDescription').value = data.description || '';
      } catch (err) {
        console.log('Profile loading error:', err);
      }
    }

    document.getElementById('profileForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = localStorage.getItem('token');
      const userId = localStorage.getItem('userId');

      const submitBtn = document.getElementById('profileSubmitBtn');
      const btnSpinner = document.getElementById('profileBtnSpinner');
      const btnText = document.getElementById('profileBtnText');

      submitBtn.disabled = true;
      btnSpinner.classList.remove('hidden');
      btnText.textContent = 'Saving…';

      const data = {
        orgName: document.getElementById('editOrgName').value,
        email: document.getElementById('editEmail').value,
        phone: document.getElementById('editPhone').value,
        address: document.getElementById('editAddress').value,
        description: document.getElementById('editDescription').value
      };

      try {
        const res = await apiFetch(`/users/${userId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          showMsg('✓ Profile updated successfully!', 'success', 'profileMsg');
          setTimeout(() => {
            loadProfileData();
            toggleProfileEdit();
          }, 1500);
        } else {
          showMsg('✗ Failed to update profile', 'error', 'profileMsg');
        }
      } catch (err) {
        showMsg(`✗ Unable to reach the server at ${API_URL}`, 'error', 'profileMsg');
      } finally {
        submitBtn.disabled = false;
        btnSpinner.classList.add('hidden');
        btnText.textContent = 'Save Changes 💾';
      }
    });

    document.getElementById('postForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = localStorage.getItem('token');
      const latitude = parseFloat(document.getElementById('pickupLatitude').value);
      const longitude = parseFloat(document.getElementById('pickupLongitude').value);

      if (Number.isNaN(latitude) || Number.isNaN(longitude)) {
        showMsg('✗ Please enter valid pickup coordinates', 'error', 'postMsg');
        return;
      }

      const submitBtn = document.getElementById('postSubmitBtn');
      const btnSpinner = document.getElementById('postBtnSpinner');
      const btnText = document.getElementById('postBtnText');

      submitBtn.disabled = true;
      btnSpinner.classList.remove('hidden');
      btnText.textContent = 'Posting Details…';

      const data = {
        name: document.getElementById('foodName').value,
        category: document.getElementById('foodCategory').value,
        quantity: parseInt(document.getElementById('foodQty').value),
        unit: document.getElementById('foodUnit').value,
        description: document.getElementById('foodDesc').value,
        expiryTime: parseInt(document.getElementById('foodExpiry').value),
        latitude,
        longitude
      };

      try {
        const res = await apiFetch('/food', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify(data)
        });

        const result = await parseJsonResponse(res);
        if (res.ok) {
          const addressLine = result?.pickupLocation?.addressSentence ? ` ${result.pickupLocation.addressSentence}` : '';
          showMsg(`✓ Food posted successfully!${addressLine}`, 'success', 'postMsg');
          document.getElementById('postForm').reset();
          document.getElementById('pickupPreview').textContent = 'Pickup address sentence will be auto-generated from these coordinates when you post.';
          
          // Re-calculate gamified impact CO2 values
          const curCo2 = parseFloat(document.getElementById('metricCo2Saved').textContent) || 0;
          document.getElementById('metricCo2Saved').textContent = (curCo2 + data.quantity * 2.5).toFixed(1);

          loadBrowseFood();
          setTimeout(() => loadMyPosts(), 1000);
        } else {
          showMsg(`✗ ${result.message || 'Failed to post'}`, 'error', 'postMsg');
        }
      } catch (err) {
        showMsg(`✗ Unable to reach the server at ${API_URL}`, 'error', 'postMsg');
      } finally {
        submitBtn.disabled = false;
        btnSpinner.classList.add('hidden');
        btnText.textContent = 'Post Details 🚀';
      }
    });

    // Define interactive detail popup helper for Leaflet markers
    window.showFoodModalFromMap = function(id) {
      if (window.currentFoodListings) {
        const f = window.currentFoodListings.find(item => item._id === id);
        if (f) showFoodModal(f);
      }
    };

    // Render interactive Leaflet Map pins based on real coordinates
    function generateMapPins(foods) {
      if (typeof L === 'undefined') {
        console.warn('Leaflet mapping library not loaded yet.');
        return;
      }

      const defaultLat = 12.9716;
      const defaultLng = 77.5946;

      // Define custom Wise-themed SVG/HTML marker icons
      const activeIcon = L.divIcon({
        className: 'custom-leaflet-marker',
        html: `
          <div class="relative flex items-center justify-center">
            <span class="absolute inline-flex h-10 w-10 rounded-full bg-primary/30 animate-ping"></span>
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-primary to-primary-active border-2 border-canvas shadow-md flex items-center justify-center text-sm select-none">
              🍽️
            </div>
          </div>
        `,
        iconSize: [40, 40],
        iconAnchor: [20, 20]
      });

      const claimedIcon = L.divIcon({
        className: 'custom-leaflet-marker',
        html: `
          <div class="relative flex items-center justify-center">
            <span class="absolute inline-flex h-10 w-10 rounded-full bg-accent-orange/30 animate-ping"></span>
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-accent-orange to-accent-orange/80 border-2 border-canvas shadow-md flex items-center justify-center text-sm select-none">
              🤝
            </div>
          </div>
        `,
        iconSize: [40, 40],
        iconAnchor: [20, 20]
      });

      const centerIcon = L.divIcon({
        className: 'custom-leaflet-marker',
        html: `
          <div class="relative flex items-center justify-center">
            <span class="absolute inline-flex h-12 w-12 rounded-full bg-accent-cyan/20 animate-ping"></span>
            <div class="w-6 h-6 rounded-full bg-accent-cyan border-2 border-canvas shadow-lg"></div>
          </div>
        `,
        iconSize: [48, 48],
        iconAnchor: [24, 24]
      });

      // Initialize map once
      if (!leafletMap) {
        const mapContainer = document.getElementById('map');
        if (!mapContainer) return;

        leafletMap = L.map('map', {
          center: [defaultLat, defaultLng],
          zoom: 13,
          zoomControl: true
        });

        // Add clean OpenStreetMap tiles
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(leafletMap);

        // Layer group to hold listings
        mapMarkersGroup = L.layerGroup().addTo(leafletMap);

        // Position current user location
        if (navigator.geolocation) {
          navigator.geolocation.getCurrentPosition(
            (position) => {
              const uLat = position.coords.latitude;
              const uLng = position.coords.longitude;
              leafletMap.setView([uLat, uLng], 13);
              L.marker([uLat, uLng], { icon: centerIcon })
                .bindPopup('<strong class="font-bold">Your NGO Center</strong>')
                .addTo(leafletMap);
            },
            () => {
              L.marker([defaultLat, defaultLng], { icon: centerIcon })
                .bindPopup('<strong class="font-bold">Your NGO Center</strong>')
                .addTo(leafletMap);
            }
          );
        } else {
          L.marker([defaultLat, defaultLng], { icon: centerIcon })
            .bindPopup('<strong class="font-bold">Your NGO Center</strong>')
            .addTo(leafletMap);
        }
      }

      // Clear existing markers
      mapMarkersGroup.clearLayers();

      // Plot available food listing coordinates
      if (Array.isArray(foods)) {
        foods.forEach((f) => {
          const lat = f.pickupLocation?.latitude;
          const lng = f.pickupLocation?.longitude;
          if (!lat || !lng) return;

          const isClaimed = localClaims[f._id] !== undefined;
          const marker = L.marker([lat, lng], {
            icon: isClaimed ? claimedIcon : activeIcon
          });

          // Bind Leaflet HTML popup to listing info
          marker.bindPopup(`
            <div class="p-xs flex flex-col gap-xxs font-inter text-xs leading-tight min-w-[150px]">
              <strong class="text-ink text-sm font-bold">${f.name}</strong>
              <span class="text-mute">${f.quantity} ${f.unit} &bull; ${f.category}</span>
              <span class="font-bold mt-xs px-sm py-[2px] rounded inline-block text-center text-[10px] uppercase select-none ${isClaimed ? 'bg-accent-orange/25 text-[#7f1d1d]' : 'bg-[#e2f6d5] text-[#054d28]' }">
                ${isClaimed ? 'Claimed' : 'Available'}
              </span>
              <button onclick="window.showFoodModalFromMap('${f._id}')" class="mt-sm bg-ink text-canvas-soft rounded-lg py-xs px-md text-[10px] font-bold cursor-pointer hover:bg-primary hover:text-ink transition-colors border-none w-full text-center">
                View Details &rarr;
              </button>
            </div>
          `);

          marker.addTo(mapMarkersGroup);
        });
      }
    }

    async function loadBrowseFood() {
      const userType = localStorage.getItem('userType') || '';
      const isNGO = userType.toLowerCase().includes('ngo');
      const userId = localStorage.getItem('userId');

      try {
        await syncClaimsFromDB();

        const res = await apiFetch('/food');
        const activeFoods = await parseJsonResponse(res);

        if (!res.ok || !Array.isArray(activeFoods)) {
          throw new Error('Food list request failed');
        }

        let foods = [...activeFoods];

        // NGO needs to see their claimed pending food items in this list too
        if (isNGO && userId) {
          try {
            const resOrders = await apiFetch(`/orders/ngo/${userId}`);
            const orders = await parseJsonResponse(resOrders);
            if (resOrders.ok && Array.isArray(orders)) {
              orders.forEach(order => {
                if (order.status === 'pending' && order.food) {
                  if (!foods.some(f => f._id === order.food._id)) {
                    foods.push(order.food);
                  }
                }
              });
            }
          } catch (err) {
            console.log('Error merging claimed items:', err);
          }
        }

        document.getElementById('metricActivePosts').textContent = activeFoods.length;
        document.getElementById('metricPickupReady').textContent = activeFoods
          ? activeFoods.filter(f => f.pickupLocation && (f.pickupLocation.addressSentence || (f.pickupLocation.latitude && f.pickupLocation.longitude))).length
          : 0;

        // Store listings cache globally for map access
        window.currentFoodListings = foods;

        // Generate Map Pins
        generateMapPins(foods);

        const tbody = document.querySelector('#browseTable tbody');
        if (!foods || foods.length === 0) {
          tbody.innerHTML = '<tr><td colspan="8" class="p-xl text-center text-mute font-semibold">No food items available at this moment.</td></tr>';
          return;
        }

        tbody.innerHTML = foods.map((f) => {
          const isClaimed = localClaims[f._id] !== undefined;
          const statusText = isClaimed ? 'Claimed' : f.status;
          
          // Compute expiry time indicator
          const hoursLeft = Number(f.expiryTime);
          let badgeColorClass = "bg-primary-pale text-positive-deep"; // active
          if (hoursLeft <= 2) {
            badgeColorClass = "bg-negative text-canvas"; // urgent - white text on red (high contrast)
          } else if (hoursLeft <= 4) {
            badgeColorClass = "bg-accent-orange/20 text-warning-deep"; // warning
          }

          let actionBtnHtml = '';
          if (isNGO) {
            if (isClaimed) {
              actionBtnHtml = `
                <button class="bg-negative hover:bg-negative-deep text-canvas py-xs px-sm rounded-lg font-bold text-xs cursor-pointer shadow-xs mr-xs focus-visible:ring-2 focus-visible:ring-negative focus-visible:outline-none" onclick="releaseFoodItem('${f._id}')">
                  Release
                </button>
                <button class="bg-primary text-on-primary hover:bg-primary-active py-xs px-sm rounded-lg font-bold text-xs cursor-pointer shadow-xs focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" onclick='showFoodModal(${JSON.stringify(f)})'>
                  Details & OTP
                </button>
              `;
            } else {
              actionBtnHtml = `
                <button class="bg-primary text-on-primary hover:bg-primary-active py-xs px-sm rounded-lg font-bold text-xs cursor-pointer shadow-xs mr-xs focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" onclick="claimFoodItem('${f._id}')">
                  Claim
                </button>
                <button class="bg-canvas-soft border border-ink text-ink hover:bg-primary-pale py-xs px-sm rounded-lg font-bold text-xs cursor-pointer focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" onclick='showFoodModal(${JSON.stringify(f)})'>
                  Details
                </button>
              `;
            }
          } else {
            actionBtnHtml = `
              <button class="bg-canvas-soft border border-ink text-ink hover:bg-primary-pale py-xs px-sm rounded-lg font-bold text-xs cursor-pointer focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none" onclick='showFoodModal(${JSON.stringify(f)})'>
                Details
              </button>
            `;
          }

          return `
            <tr class="hover:bg-canvas-soft/20 border-b border-canvas-soft">
              <td class="p-md font-bold text-ink">${f.name}</td>
              <td class="p-md text-mute select-none">${f.category}</td>
              <td class="p-md font-semibold tabular-nums">${f.quantity}</td>
              <td class="p-md select-none">${f.unit}</td>
              <td class="p-md"><span class="px-sm py-[2px] rounded-full text-xs font-bold select-none border ${isClaimed ? 'bg-warning-deep/15 text-warning-deep border-warning/20' : 'bg-primary-pale text-positive-deep border-primary/25'}">${statusText}</span></td>
              <td class="p-md"><span class="px-sm py-[2px] rounded-md text-xs font-bold tabular-nums ${badgeColorClass}">${hoursLeft}h</span></td>
              <td class="p-md text-xs text-body font-medium">${f.pickupLocation?.addressSentence || `Coordinates: ${f.pickupLocation?.latitude?.toFixed(4) || '-'}, ${f.pickupLocation?.longitude?.toFixed(4) || '-'}`}</td>
              <td class="p-md whitespace-nowrap text-right">${actionBtnHtml}</td>
            </tr>
          `;
        }).join('');
      } catch (err) {
        document.querySelector('#browseTable tbody').innerHTML = '<tr><td colspan="8" class="p-xl text-center text-mute font-semibold">Error loading listings.</td></tr>';
      }
    }

    async function loadMyPosts() {
      const token = localStorage.getItem('token');
      const userId = localStorage.getItem('userId');

      try {
        const res = await apiFetch(`/food/restaurant/${userId}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const foods = await parseJsonResponse(res);

        if (!res.ok || !Array.isArray(foods)) {
          throw new Error('My posts request failed');
        }

        document.getElementById('metricMyPosts').textContent = Array.isArray(foods) ? foods.length : 0;

        // Cumulative CO2 Offset score estimation (approx 2.5 kg CO2 saved per food unit)
        const totalQty = foods.reduce((sum, f) => sum + (f.quantity || 0), 0);
        document.getElementById('metricCo2Saved').textContent = (totalQty * 2.5).toFixed(1);

        const tbody = document.querySelector('#myPostsTable tbody');
        if (!foods || foods.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="p-xl text-center text-mute font-semibold">You haven’t posted any active surplus meals yet.</td></tr>';
          return;
        }

        tbody.innerHTML = foods.map(f => `
          <tr class="hover:bg-canvas-soft/20 border-b border-canvas-soft">
            <td class="p-md font-bold text-ink">${f.name}</td>
            <td class="p-md text-mute select-none">${f.category}</td>
            <td class="p-md font-semibold tabular-nums">${f.quantity}</td>
            <td class="p-md select-none">${f.unit}</td>
            <td class="p-md"><span class="px-sm py-[2px] rounded-full text-xs font-bold border select-none ${f.status === 'Claimed' ? 'bg-warning-deep/15 text-warning-deep border-warning/20' : 'bg-primary-pale text-positive-deep border-primary/25'}">${f.status}</span></td>
            <td class="p-md font-semibold text-mute tabular-nums">${f.expiryTime}h</td>
            <td class="p-md text-right">
              <button class="bg-negative/10 hover:bg-negative/20 text-negative border border-negative/20 py-xs px-sm rounded-lg font-bold text-xs cursor-pointer shadow-xs focus-visible:ring-2 focus-visible:ring-negative focus-visible:outline-none" onclick="deleteFoodPost('${f._id}')">
                Delete
              </button>
            </td>
          </tr>
        `).join('');
      } catch (err) {
        document.querySelector('#myPostsTable tbody').innerHTML = '<tr><td colspan="7" class="p-xl text-center text-mute font-semibold">Error loading posts.</td></tr>';
      }
    }

    async function deleteFoodPost(foodId) {
      const token = localStorage.getItem('token');
      if (!token) return;

      const confirmed = window.confirm('Are you sure you want to delete this food listing?');
      if (!confirmed) return;

      try {
        const res = await apiFetch(`/food/${foodId}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });

        const result = await parseJsonResponse(res);
        if (res.ok) {
          showMsg('✓ Food post deleted successfully', 'success', 'myPostsMsg');
          loadMyPosts();
          loadBrowseFood();
        } else {
          showMsg(`✗ ${result.message || 'Failed to delete food post'}`, 'error', 'myPostsMsg');
        }
      } catch (err) {
        showMsg(`✗ Unable to reach the server at ${API_URL}`, 'error', 'myPostsMsg');
      }
    }

    async function autoRemoveExpiredFood() {
      const token = localStorage.getItem('token');
      if (!token) return;
      try {
        await apiFetch('/food/auto-remove', {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        loadBrowseFood();
        const userType = localStorage.getItem('userType') || '';
        if (!userType.toLowerCase().includes('ngo')) loadMyPosts();
      } catch (err) {
        console.log('Auto-remove error:', err);
      }
    }

    window.logout = function() {
      localStorage.clear();
      window.location.href = '/';
    };


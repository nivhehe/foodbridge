    function updatePickupPreview() {
      const latitudeValue = document.getElementById('pickupLatitude').value;
      const longitudeValue = document.getElementById('pickupLongitude').value;
      const preview = document.getElementById('pickupPreview');

      if (!latitudeValue || !longitudeValue) {
        preview.textContent = 'Pickup address sentence will be auto-generated from these coordinates when you post.';
        return;
      }

      preview.textContent = `Pickup location sentence preview: Pickup is available at coordinates (${latitudeValue}, ${longitudeValue}).`;
    }

    window.fillCurrentCoordinates = function() {
      if (!navigator.geolocation) {
        showMsg('✗ Geolocation is not supported on this browser', 'error', 'postMsg');
        return;
      }

      navigator.geolocation.getCurrentPosition(
        (position) => {
          const latitude = Number(position.coords.latitude.toFixed(6));
          const longitude = Number(position.coords.longitude.toFixed(6));
          document.getElementById('pickupLatitude').value = latitude;
          document.getElementById('pickupLongitude').value = longitude;
          updatePickupPreview();
        },
        () => {
          showMsg('✗ Could not fetch current location. Please enter coordinates manually.', 'error', 'postMsg');
        }
      );
    };

    document.getElementById('pickupLatitude').addEventListener('input', updatePickupPreview);
    document.getElementById('pickupLongitude').addEventListener('input', updatePickupPreview);

    // CHAT SYSTEM CLIENT-SIDE LOGIC
    async function loadChatsList() {
      const token = localStorage.getItem('token');
      const userId = localStorage.getItem('userId');
      const userType = localStorage.getItem('userType') || '';
      const isNGO = userType.toLowerCase().includes('ngo');

      if (!token || !userId) return;

      const container = document.getElementById('chatsListContainer');
      if (!container) return;

      try {
        let res;
        if (isNGO) {
          res = await apiFetch(`/orders/ngo/${userId}`);
        } else {
          res = await apiFetch(`/orders/restaurant/${userId}`);
        }

        const orders = await parseJsonResponse(res);
        if (!res.ok || !Array.isArray(orders)) {
          throw new Error('Chats list request failed');
        }

        const validOrders = orders.filter(order => order.food);
        document.getElementById('chatCount').textContent = validOrders.length;

        if (validOrders.length === 0) {
          container.innerHTML = '<div class="text-center text-mute py-xl font-semibold select-none">No active donation claims or conversations found.</div>';
          return;
        }

        container.innerHTML = validOrders.map(order => {
          const isPending = order.status === 'pending';
          const partner = isNGO 
            ? (order.food.postedBy || {})
            : (typeof order.ngo === 'object' ? order.ngo : {});
          
          const partnerName = partner.orgName || 'Unknown';
          const partnerType = partner.userType || (isNGO ? 'restaurant' : 'ngo');
          const partnerLabel = partnerName === 'Unknown' 
            ? `Unknown ${partnerType.charAt(0).toUpperCase() + partnerType.slice(1)}`
            : partnerName;
          const foodName = order.food.name || 'Unknown Food';
          const safePartnerName = partnerLabel.replace(/'/g, "\\'");
          const safeFoodName = foodName.replace(/'/g, "\\'");
          const partnerPhone = partner.phone || '';
          const partnerEmail = partner.email || '';

          const isSelected = activeOrderId === order._id;
          const bgClass = isSelected 
            ? 'bg-primary/10 border-primary/40' 
            : 'bg-canvas hover:bg-canvas-soft border-ink/5';

          const statusBadge = isPending 
            ? `<span class="bg-warning-deep/15 text-warning-deep border border-warning/20 px-sm py-[2px] rounded-full text-[10px] font-bold">Pending Pickup</span>`
            : `<span class="bg-primary-pale text-positive-deep border border-primary/25 px-sm py-[2px] rounded-full text-[10px] font-bold">Completed</span>`;

          return `
            <div class="p-md rounded-xl border cursor-pointer transition-all ${bgClass} flex flex-col gap-xs select-none" onclick="window.openChatRoom('${order._id}', '${safePartnerName}', '${safeFoodName}', '${partnerPhone}', '${partnerEmail}')">
              <div class="flex justify-between items-start gap-sm">
                <strong class="body-sm-strong text-ink font-bold truncate flex-1">${partnerLabel}</strong>
                ${statusBadge}
              </div>
              <div class="caption text-mute text-[12px] truncate">Food: ${foodName}</div>
              <div class="flex justify-between items-center text-[10px] text-mute mt-[2px] font-semibold">
                <span>Handshake: ${order.handshakeCode}</span>
                <span class="tabular-nums">${new Date(order.createdAt).toLocaleDateString()}</span>
              </div>
            </div>
          `;
        }).join('');
      } catch (err) {
        console.log('Error loading chats list:', err);
        container.innerHTML = '<div class="text-center text-negative py-xl font-semibold">Failed to load conversations.</div>';
      }
    }

    window.openChatRoom = async function(orderId, partnerName, foodTitle, phone, email) {
      if (activeChatPollInterval) {
        clearInterval(activeChatPollInterval);
      }

      activeOrderId = orderId;
      loadChatsList();

      document.getElementById('chatPartnerName').textContent = partnerName;
      document.getElementById('chatFoodTitle').textContent = `Coordination: ${foodTitle}`;
      
      const phoneBtn = document.getElementById('chatPartnerPhone');
      if (phone) {
        phoneBtn.href = `tel:${phone}`;
        phoneBtn.style.display = 'flex';
      } else {
        phoneBtn.style.display = 'none';
      }

      const emailBtn = document.getElementById('chatPartnerEmail');
      if (email) {
        emailBtn.href = `mailto:${email}`;
        emailBtn.style.display = 'flex';
      } else {
        emailBtn.style.display = 'none';
      }

      document.getElementById('chatRoomEmptyState').style.display = 'none';
      document.getElementById('chatRoomActiveState').classList.remove('hidden');
      document.getElementById('chatRoomActiveState').style.display = 'flex';

      await fetchMessages(orderId);

      activeChatPollInterval = setInterval(() => {
        fetchMessages(orderId, true);
      }, 3000);
    };

    let lastFetchedMessageCount = 0;

    async function fetchMessages(orderId, isPoll = false) {
      const token = localStorage.getItem('token');
      const userId = localStorage.getItem('userId');
      if (!token || !userId) return;

      try {
        const res = await apiFetch(`/messages/${orderId}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const messages = await parseJsonResponse(res);

        if (!res.ok || !Array.isArray(messages)) return;

        if (isPoll && messages.length === lastFetchedMessageCount) {
          return;
        }

        lastFetchedMessageCount = messages.length;
        const historyContainer = document.getElementById('chatHistoryContainer');
        if (!historyContainer) return;

        if (messages.length === 0) {
          historyContainer.innerHTML = `
            <div class="flex-1 flex flex-col items-center justify-center text-center p-lg select-none text-mute">
              <span class="text-3xl mb-xs">🤝</span>
              <p class="body-sm font-semibold">No messages yet.</p>
              <p class="caption">Send a message to coordinate pickup details, timing, or coordinates.</p>
            </div>
          `;
          return;
        }

        historyContainer.innerHTML = messages.map(msg => {
          const isMe = msg.sender && (msg.sender._id === userId || msg.sender === userId);
          
          const bubbleBg = isMe 
            ? 'bg-primary text-on-primary rounded-tr-none' 
            : 'bg-canvas border border-ink/5 text-ink rounded-tl-none';
          
          const alignClass = isMe ? 'items-end' : 'items-start';
          
          const timeStr = new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          const senderOrgName = msg.sender?.orgName || '';
          const senderType = msg.sender?.userType || '';
          const senderLabel = senderOrgName 
            ? `${senderOrgName}${senderType ? ` (${senderType})` : ''}`
            : senderType 
              ? `${senderType.charAt(0).toUpperCase() + senderType.slice(1)} User`
              : 'User';
          const msgId = msg._id;

          const deleteBtn = isMe ? `
            <button class="delete-msg-btn opacity-0 group-hover:opacity-100 transition-opacity text-mute hover:text-negative text-[10px] font-bold cursor-pointer" data-msg-id="${msgId}" onclick="window.deleteMessage('${msgId}')" title="Delete message">✕</button>
          ` : '';

          return `
            <div class="flex flex-col gap-[3px] max-w-[85%] ${isMe ? 'self-end' : 'self-start'} ${alignClass} group">
              <div class="caption text-[10px] text-mute font-bold px-xxs select-none flex items-center gap-xs">${senderLabel}${deleteBtn}</div>
              <div class="${bubbleBg} px-md py-sm rounded-2xl shadow-sm text-sm break-words leading-relaxed">${msg.text}</div>
              <div class="caption text-[9px] text-mute font-semibold px-xxs tabular-nums select-none">${timeStr}</div>
            </div>
          `;
        }).join('');

        historyContainer.scrollTop = historyContainer.scrollHeight;
      } catch (err) {
        console.log('Error fetching messages:', err);
      }
    }

    window.deleteMessage = async function(messageId) {
      const token = localStorage.getItem('token');
      if (!token || !messageId) return;

      try {
        const res = await apiFetch(`/messages/${messageId}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });

        if (res.ok && activeOrderId) {
          await fetchMessages(activeOrderId);
        }
      } catch (err) {
        console.log('Error deleting message:', err);
      }
    };

    window.openChatFromDetails = function(orderId, partnerName, foodTitle, phone, email) {
      closeFoodModal();
      switchTab('chats');
      window.openChatRoom(orderId, partnerName, foodTitle, phone, email);
    };

    window.addEventListener('load', () => {
      // Chat message sender listener
      const chatForm = document.getElementById('chatSendForm');
      if (chatForm) {
        chatForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const token = localStorage.getItem('token');
          const input = document.getElementById('chatMessageInput');
          const text = input.value.trim();
          
          if (!text || !activeOrderId || !token) return;

          input.value = '';
          input.disabled = true;

          try {
            const res = await apiFetch(`/messages/${activeOrderId}`, {
              method: 'POST',
              headers: { 
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}` 
              },
              body: JSON.stringify({ text })
            });

            if (res.ok) {
              await fetchMessages(activeOrderId);
            } else {
              console.error('Failed to send message');
              input.value = text;
            }
          } catch (err) {
            console.error('Error sending message:', err);
            input.value = text;
          } finally {
            input.disabled = false;
            input.focus();
          }
        });
      }
      const token = localStorage.getItem('token');
      const userId = localStorage.getItem('userId');
      const userType = localStorage.getItem('userType') || '';

      if (!token) {
        window.location.href = '/';
        return;
      }

      const isNGO = userType.toLowerCase().includes('ngo');

      // Set user info
      document.getElementById('userName').textContent = userType || 'User';
      document.getElementById('userType').textContent = isNGO ? 'NGO / Charitable Recipient' : 'Restaurant / Donor';
      document.getElementById('userAvatar').textContent = userType ? userType.charAt(0).toUpperCase() : 'U';

      // Hide sections for NGO
      if (isNGO) {
        document.getElementById('nav-post').style.display = 'none';
        document.getElementById('post').style.display = 'none';
        document.getElementById('nav-myposts').style.display = 'none';
        document.getElementById('myposts').style.display = 'none';
        
        document.getElementById('orgNameLabel').textContent = 'NGO / Charity Name';
        document.getElementById('orgNameEditLabel').textContent = 'NGO / Charity Name *';
        document.getElementById('metricMyPostsLabel').textContent = 'Live Claims List';
        
        // Count claims dynamically
        document.getElementById('metricMyPosts').textContent = Object.keys(localClaims).length;
      }

      loadProfileData();
      loadBrowseFood();
      loadHistory();
      if (!isNGO) loadMyPosts();
      autoRemoveExpiredFood();
      setInterval(autoRemoveExpiredFood, 60000); // Check every minute
      renderApiBadge();
    });
  </script>
</Layout>

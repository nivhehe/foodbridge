---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Us - FoodBridge | Get in Touch with Our Team"
  description="Contact FoodBridge for support, partnerships, or media inquiries. Reach out to our team to help reduce food waste today."
>
  <div class="max-w-[1240px] mx-auto px-lg py-md md:py-xl">
    
    <!-- Sticky Top Navigation -->
    <header class="sticky top-md z-50 flex flex-col md:flex-row items-center justify-between gap-md p-md bg-canvas/80 backdrop-blur-md border border-canvas/20 rounded-2xl md:rounded-full shadow-md mb-xl">
      <a href="/" class="flex items-center gap-md hover:opacity-90 transition-opacity">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl bg-gradient-to-br from-primary/30 to-accent-orange/30 shadow-inner">
          🍽️
        </div>
        <div>
          <div class="font-wise-sans font-black text-2xl tracking-tight leading-none text-ink">FoodBridge</div>
          <div class="text-[10px] text-mute font-semibold uppercase tracking-wider mt-[2px]">Smart Redistribution</div>
        </div>
      </a>

      <nav class="flex items-center gap-xs md:gap-md flex-wrap justify-center">
        <a href="/" class="px-md py-sm rounded-full text-mute hover:text-ink hover:bg-canvas-soft text-sm font-semibold transition-all duration-200">Home</a>
        <a href="/about" class="px-md py-sm rounded-full text-mute hover:text-ink hover:bg-canvas-soft text-sm font-semibold transition-all duration-200">About Us</a>
        <a href="/contact" class="px-md py-sm rounded-full bg-primary text-on-primary text-sm font-semibold transition-all duration-200">Contact</a>
        <a href="/privacy-policy" class="px-md py-sm rounded-full text-mute hover:text-ink hover:bg-canvas-soft text-sm font-semibold transition-all duration-200">Privacy</a>
        <a href="/terms-conditions" class="px-md py-sm rounded-full text-mute hover:text-ink hover:bg-canvas-soft text-sm font-semibold transition-all duration-200">Terms</a>
        <button id="themeToggleBtn" onclick="toggleTheme()" class="w-9 h-9 rounded-full bg-canvas border border-ink/10 flex items-center justify-center text-ink hover:bg-canvas-soft cursor-pointer transition-colors focus:outline-none focus:ring-2 focus:ring-primary shrink-0" aria-label="Toggle Dark Mode">
          <!-- Sun Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px] block dark:hidden"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          <!-- Moon Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px] hidden dark:block"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>
        <a href="/#auth" class="bg-primary text-on-primary hover:bg-primary-active transition-all duration-200 rounded-full px-xl py-sm text-sm font-bold shadow-md">Get Started</a>
      </nav>
    </header>

    <!-- Main Content Grid -->
    <main class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-xl items-stretch">
      
      <!-- Left: Interactive Contact Form Panel -->
      <section class="bg-canvas rounded-xl p-xl md:p-2xl shadow-sm border border-canvas/20 flex flex-col justify-between relative overflow-hidden">
        <div class="relative z-10">
          <span class="inline-flex items-center gap-xs px-md py-xs mb-md rounded-full text-xs font-extrabold text-positive-deep bg-primary-pale border border-primary-neutral/40 tracking-wide uppercase">
            Get In Touch
          </span>
          <h1 class="display-sm text-ink mb-md tracking-tight">
            How can we help your team?
          </h1>
          <p class="body-md text-body mb-xl">
            Have a question about onboarding your restaurant or NGO? Interested in a corporate partnership or local integration? Send us a message and our team will follow up quickly.
          </p>

          <!-- Form Message Alert -->
          <div id="contactStatusAlert" class="hidden p-md rounded-xl text-sm font-bold leading-relaxed mb-lg border transition-all duration-200"></div>

          <!-- Contact Form -->
          <form id="contactForm" class="flex flex-col gap-md">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
              <div class="flex flex-col gap-xs">
                <label for="contactName" class="body-sm-strong text-ink">Your Name</label>
                <input type="text" id="contactName" class="bg-canvas text-ink border border-ink/20 rounded-md p-md body-md focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/15 transition-all duration-200" placeholder="Jane Doe" required />
              </div>
              <div class="flex flex-col gap-xs">
                <label for="contactEmail" class="body-sm-strong text-ink">Email Address</label>
                <input type="email" id="contactEmail" class="bg-canvas text-ink border border-ink/20 rounded-md p-md body-md focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/15 transition-all duration-200" placeholder="jane@example.com" required />
              </div>
            </div>

            <div class="flex flex-col gap-xs">
              <label for="contactSubject" class="body-sm-strong text-ink">Inquiry Subject</label>
              <select id="contactSubject" class="bg-canvas text-ink border border-ink/20 rounded-md p-md body-md focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/15 transition-all duration-200" required>
                <option value="">Select a subject</option>
                <option value="donor-onboarding">Restaurant / Donor Signup Questions</option>
                <option value="ngo-onboarding">NGO / Recipient Verification</option>
                <option value="partnerships">Corporate / Regional Partnerships</option>
                <option value="technical-support">Technical Platform Support</option>
                <option value="other">General Inquiry</option>
              </select>
            </div>

            <div class="flex flex-col gap-xs">
              <label for="contactMessage" class="body-sm-strong text-ink">Your Message</label>
              <textarea id="contactMessage" rows="5" class="bg-canvas text-ink border border-ink/20 rounded-md p-md body-md focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/15 transition-all duration-200 resize-y" placeholder="Describe how we can support you..." required></textarea>
            </div>

            <button type="submit" id="contactSubmitBtn" class="bg-primary text-on-primary hover:bg-primary-active transition-all duration-200 rounded-xl py-md text-base font-bold shadow-sm w-full cursor-pointer mt-sm inline-flex items-center justify-center gap-sm">
              <span>Send Message</span>
              <svg id="contactSubmitSpinner" class="hidden w-5 h-5 animate-spin text-on-primary" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </form>
        </div>
        <div class="absolute -right-20 -bottom-20 w-64 h-64 rounded-full bg-gradient-to-br from-accent-orange/10 to-transparent blur-2xl pointer-events-none"></div>
      </section>

      <!-- Right: Office Coordination & Trust Panel -->
      <aside class="bg-canvas-soft rounded-xl p-xl md:p-2xl border border-canvas-soft/40 shadow-xs flex flex-col justify-between gap-xl">
        <div class="space-y-lg">
          <h2 class="display-xs text-ink">Office Coordination</h2>
          <p class="body-sm text-body leading-relaxed">
            While our digital redistribution platform operates 24/7, our operations and partner-onboarding team is active during standard coordination hours.
          </p>

          <!-- Email Contacts -->
          <div class="space-y-md">
            <div class="bg-canvas p-lg rounded-xl shadow-xs border border-canvas-soft flex items-center justify-between gap-md">
              <div>
                <strong class="body-md-strong text-ink block">Email Support</strong>
                <span class="body-sm text-body">Technical & account help</span>
              </div>
              <a href="mailto:foodbridge.online@gmail.com" class="text-sm font-bold text-accent-orange hover:underline shrink-0">foodbridge.online@gmail.com</a>
            </div>

          </div>
        </div>

        <!-- Working Hours & Coordinate Details -->
        <div class="bg-ink text-primary-pale p-lg rounded-xl space-y-md border border-ink/40">
          <div>
            <strong class="body-sm-strong text-primary block uppercase tracking-wider mb-[2px]">Working Hours</strong>
            <p class="body-sm text-canvas-soft/80">
              Monday to Friday: 9:00 AM - 6:00 PM PST<br/>
              Urgent Donor Pickup Line: 24 Hours
            </p>
          </div>
        </div>
      </aside>

    </main>

    <!-- Success Toast Popups Container -->
    <div id="contactToastContainer" class="fixed bottom-lg right-lg z-50 flex flex-col gap-sm max-w-sm pointer-events-none"></div>

    <!-- Footer -->
    <footer class="bg-ink text-canvas-soft rounded-xl p-xl md:p-2xl shadow-sm relative overflow-hidden mt-xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-xl mb-2xl relative z-10">
        <div>
          <h3 class="display-xs text-primary font-black mb-md">FoodBridge</h3>
          <p class="body-sm text-canvas-soft/70 leading-relaxed max-w-[384px]">
            Connecting food businesses and NGOs to reduce waste and support local communities.
          </p>
        </div>

        <div class="flex flex-col gap-sm">
          <strong class="body-md-strong text-primary mb-xs">Platform</strong>
          <a href="/#how-it-works" class="body-sm text-canvas-soft/80 hover:text-primary transition-colors">How It Works</a>
          <a href="/#impact" class="body-sm text-canvas-soft/80 hover:text-primary transition-colors">Impact</a>
          <a href="/#auth" class="body-sm text-canvas-soft/80 hover:text-primary transition-colors">Get Started</a>
        </div>

        <div class="flex flex-col gap-sm">
          <strong class="body-md-strong text-primary mb-xs">Company</strong>
          <a href="/about" class="body-sm text-canvas-soft/80 hover:text-primary transition-colors">About Us</a>
          <a href="/contact" class="body-sm text-canvas-soft/80 hover:text-primary transition-colors">Contact Us</a>
          <a href="/privacy-policy" class="body-sm text-canvas-soft/80 hover:text-primary transition-colors">Privacy Policy</a>
          <a href="/terms-conditions" class="body-sm text-canvas-soft/80 hover:text-primary transition-colors">Terms & Conditions</a>
        </div>
      </div>

      <div class="border-t border-canvas-soft/10 pt-lg flex flex-col md:flex-row items-center justify-between gap-md relative z-10 text-xs text-canvas-soft/50">
        <div>© 2026 FoodBridge. Designed to reduce waste and improve food access.</div>
        <div>Privacy, terms, and support are now visible in the public landing flow.</div>
      </div>
      
      <div class="absolute -right-20 -top-20 w-64 h-64 rounded-full bg-primary/5 blur-2xl pointer-events-none"></div>
    </footer>

  </div>

  <!-- Client-Side Script for Form Interactions -->
  <script is:inline>
    const form = document.getElementById('contactForm');
    const submitBtn = document.getElementById('contactSubmitBtn');
    const submitSpinner = document.getElementById('contactSubmitSpinner');
    const statusAlert = document.getElementById('contactStatusAlert');
    const toastContainer = document.getElementById('contactToastContainer');

    function showToast(message) {
      const toast = document.createElement('div');
      toast.className = 'pointer-events-auto bg-ink text-primary-pale p-lg rounded-xl border border-primary/20 shadow-lg transform translate-y-2 opacity-0 transition-all duration-300 flex items-start gap-md';
      toast.innerHTML = `
        <span class="text-primary text-lg shrink-0">✉</span>
        <div>
          <strong class="body-sm-strong text-primary block">Message Transmitted</strong>
          <p class="caption text-canvas-soft/80 mt-[2px]">${message}</p>
        </div>
      `;
      toastContainer.appendChild(toast);
      
      // Force layout calculation
      toast.offsetHeight;
      
      // Animate in
      toast.classList.remove('translate-y-2', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      // Dismiss after 4 seconds
      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-2', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const name = document.getElementById('contactName').value.trim();
      const email = document.getElementById('contactEmail').value.trim();
      const subject = document.getElementById('contactSubject').value;
      const message = document.getElementById('contactMessage').value.trim();

      if (!name || !email || !subject || !message) {
        statusAlert.textContent = 'Please complete all required fields.';
        statusAlert.className = 'p-md rounded-xl text-sm font-bold leading-relaxed mb-lg border bg-negative-bg text-negative-darkest! border-negative/20 block';
        return;
      }

      // Enter loading state
      submitBtn.disabled = true;
      submitSpinner.classList.remove('hidden');
      statusAlert.classList.add('hidden');

      // Simulate contact form submission
      setTimeout(() => {
        // Exit loading state
        submitBtn.disabled = false;
        submitSpinner.classList.add('hidden');

        // Reset form
        form.reset();

        // Show inline alert & toast notification
        statusAlert.textContent = '✓ Message sent successfully! Our coordination team has been notified.';
        statusAlert.className = 'p-md rounded-xl text-sm font-bold leading-relaxed mb-lg border bg-primary-pale text-positive-deep border-positive/20 block';
        
        showToast('Thank you! Your message has been received. Our team will get back to you within 24 business hours.');
      }, 1200);
    });
  </script>
</Layout>
